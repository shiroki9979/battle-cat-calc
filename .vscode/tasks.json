{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build client",
      "type": "shell",
      "command": "npm ci && npm run build",
      "options": { "cwd": "${workspaceFolder}/dotnet/client" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "test client",
      "type": "process",
      "command": "npm",
      "args": ["run", "test:e2e"],
      "options": { "cwd": "${workspaceFolder}/dotnet/client" },
      "problemMatcher": []
    },
    {
      "label": "build API",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/BattleCatCalc.Api/BattleCatCalc.Api.csproj"],
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch", "--non-interactive", "--project",
        "src/BattleCatCalc.Api/BattleCatCalc.Api.csproj", "run", "--no-launch-profile"
      ],
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "problemMatcher": []
    },
    {
      "label": "test solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test", "BattleCatCalc.slnx", "--logger", "trx", "--collect",
        "XPlat Code Coverage", "--results-directory", "/test-results"
      ],
      "options": { "cwd": "${workspaceFolder}/dotnet" },
      "problemMatcher": "$msCompile"
    }
  ]
}
